`timescale 1ns / 1ps

module testbench;

    // Testbench Stimulus Signals
    reg [2:0]  funct3;
    reg [1:0]  addr_offset;
    reg [31:0] reg_wdata;
    reg [31:0] dmem_rdata;

    // Unit Output Signals
    wire [31:0] dmem_wdata;
    wire [31:0] cpu_rdata;

    // Test Tracking Variables
    integer pass_count = 0;
    integer fail_count = 0;
    integer test_num   = 0;
    integer i, j;

    // Instantiate Unit Under Test
    load_store_unit uut (
        .funct3(funct3),
        .addr_offset(addr_offset),
        .reg_wdata(reg_wdata),
        .dmem_rdata(dmem_rdata),
        .dmem_wdata(dmem_wdata),
        .cpu_rdata(cpu_rdata)
    );

    // Waveform Generation Setup
    initial begin
        $dumpfile("testbench.vcd");
        $dumpvars(0, testbench);
    end

    // ------------------------------------------------------------------
    // Automated Evaluation Task (Golden Model Checker)
    // ------------------------------------------------------------------
    task run_test(
        input [2:0]  t_funct3,
        input [1:0]  t_offset,
        input [31:0] t_wdata,
        input [31:0] t_rdata,
        input [127:0] op_name  // Opcode label string for logging
    );
        reg [31:0] exp_dmem_wdata;
        reg [31:0] exp_cpu_rdata;
        reg store_ok, load_ok;
        begin
            test_num = test_num + 1;

            // Apply inputs
            funct3      = t_funct3;
            addr_offset = t_offset;
            reg_wdata   = t_wdata;
            dmem_rdata  = t_rdata;
            #10; // Allow combinational logic to settle

            // 1. Compute Expected Store Output (dmem_wdata)
            case (t_funct3)
                3'b000: begin // SB
                    case (t_offset)
                        2'b00: exp_dmem_wdata = {t_rdata[31:8],  t_wdata[7:0]};
                        2'b01: exp_dmem_wdata = {t_rdata[31:16], t_wdata[7:0], t_rdata[7:0]};
                        2'b10: exp_dmem_wdata = {t_rdata[31:24], t_wdata[7:0], t_rdata[15:0]};
                        2'b11: exp_dmem_wdata = {t_wdata[7:0],    t_rdata[23:0]};
                    endcase
                end
                3'b001: begin // SH
                    case (t_offset[1])
                        1'b0:  exp_dmem_wdata = {t_rdata[31:16], t_wdata[15:0]};
                        1'b1:  exp_dmem_wdata = {t_wdata[15:0],   t_rdata[15:0]};
                    endcase
                end
                default: exp_dmem_wdata = t_wdata; // SW / default
            endcase

            // 2. Compute Expected Load Output (cpu_rdata)
            case (t_funct3)
                3'b000: begin // LB (Signed)
                    case (t_offset)
                        2'b00: exp_cpu_rdata = {{24{t_rdata[7]}},  t_rdata[7:0]};
                        2'b01: exp_cpu_rdata = {{24{t_rdata[15]}}, t_rdata[15:8]};
                        2'b10: exp_cpu_rdata = {{24{t_rdata[23]}}, t_rdata[23:16]};
                        2'b11: exp_cpu_rdata = {{24{t_rdata[31]}}, t_rdata[31:24]};
                    endcase
                end
                3'b001: begin // LH (Signed)
                    case (t_offset[1])
                        1'b0:  exp_cpu_rdata = {{16{t_rdata[15]}}, t_rdata[15:0]};
                        1'b1:  exp_cpu_rdata = {{16{t_rdata[31]}}, t_rdata[31:16]};
                    endcase
                end
                3'b100: begin // LBU (Unsigned)
                    case (t_offset)
                        2'b00: exp_cpu_rdata = {24'b0, t_rdata[7:0]};
                        2'b01: exp_cpu_rdata = {24'b0, t_rdata[15:8]};
                        2'b10: exp_cpu_rdata = {24'b0, t_rdata[23:16]};
                        2'b11: exp_cpu_rdata = {24'b0, t_rdata[31:24]};
                    endcase
                end
                3'b101: begin // LHU (Unsigned)
                    case (t_offset[1])
                        1'b0:  exp_cpu_rdata = {16'b0, t_rdata[15:0]};
                        1'b1:  exp_cpu_rdata = {16'b0, t_rdata[31:16]};
                    endcase
                end
                default: exp_cpu_rdata = t_rdata; // LW / default
            endcase

            // 3. Automated Check
            store_ok = (dmem_wdata === exp_dmem_wdata);
            load_ok  = (cpu_rdata  === exp_cpu_rdata);

            if (store_ok && load_ok) begin
                $display("[PASS] Test #%02d [%-4s] Offset:%0d | dmem_wdata=0x%h, cpu_rdata=0x%h",
                         test_num, op_name, t_offset, dmem_wdata, cpu_rdata);
                pass_count = pass_count + 1;
            end else begin
                $display("[FAIL] Test #%02d [%-4s] Offset:%0d", test_num, op_name, t_offset);
                if (!store_ok)
                    $display("       └─ Store Mismatch: Got 0x%h, Expected 0x%h", dmem_wdata, exp_dmem_wdata);
                if (!load_ok)
                    $display("       └─ Load  Mismatch: Got 0x%h, Expected 0x%h", cpu_rdata, exp_cpu_rdata);
                fail_count = fail_count + 1;
            end
        end
    endtask

    // ------------------------------------------------------------------
    // Execution Sequence
    // ------------------------------------------------------------------
    initial begin
        $display("=======================================================================");
        $display("           STARTING AUTOMATED LOAD/STORE UNIT TESTBENCH                ");
        $display("=======================================================================");

        // --- SECTION 1: Standard Verification Cases ---
        run_test(3'b000, 2'b01, 32'h000000FF, 32'h12345678, "SB");
        run_test(3'b001, 2'b10, 32'h0000AABB, 32'h12345678, "SH");
        run_test(3'b010, 2'b00, 32'hDEADBEEF, 32'h12345678, "SW");
        run_test(3'b000, 2'b00, 32'h00000000, 32'h12345680, "LB");
        run_test(3'b100, 2'b00, 32'h00000000, 32'h12345680, "LBU");
        run_test(3'b001, 2'b00, 32'h00000000, 32'h12348000, "LH");
        run_test(3'b101, 2'b00, 32'h00000000, 32'h12348000, "LHU");
        run_test(3'b010, 2'b00, 32'h00000000, 32'hCAFEFEED, "LW");

        // --- SECTION 2: Automated Sweep (All 8 funct3 & 4 Offsets with Pseudo-Random Data) ---
        $display("-----------------------------------------------------------------------");
        $display("Running Automated Loop Across All Funct3 & Address Offsets...");
        $display("-----------------------------------------------------------------------");
        for (i = 0; i < 8; i = i + 1) begin
            for (j = 0; j < 4; j = j + 1) begin
                run_test(i[2:0], j[1:0], $random, $random, "AUTO");
            end
        end

        // --- Final Summary ---
        $display("=======================================================================");
        $display("TEST SUMMARY: %0d PASSED, %0d FAILED OUT OF %0d TESTS", pass_count, fail_count, test_num);
        $display("=======================================================================");
        #10;
        $finish;
    end

endmodule
