module testbench();

    reg [31:0] i_Instruction = 0;
    wire [31:0] o_Immediate;

    // Instantiate Unit Under Test (UUT)
    top ai45 (
        .i_Instruction(i_Instruction), 
        .o_Immediate(o_Immediate)
    );

    // Waveform Dump Config
    initial begin 
        $dumpfile("testbench.vcd");
        $dumpvars(0, testbench);
    end 

    // Function to automatically decode the instruction type string from the opcode
    function [63:0] auto_decode_type;
        input [6:0] opcode;
        begin
            case (opcode)
                7'b1101111: auto_decode_type = "J-Type  ";
                7'b1100011: auto_decode_type = "B-Type  ";
                7'b0100011: auto_decode_type = "S-Type  ";
                7'b0010011,
                7'b0000011,
                7'b1100111: auto_decode_type = "I-Type  ";
                default:    auto_decode_type = "I-Type* "; // Default fallback matching module logic
            endcase
        end
    endfunction

    // Helper task to apply stimulus and print results automatically
    task apply_test;
        input [31:0] inst;
        begin
            i_Instruction = inst;
            #10;
            $display("%8t | %h    | %s | %h   | %d", 
                     $time, 
                     i_Instruction, 
                     auto_decode_type(i_Instruction[6:0]), 
                     o_Immediate, 
                     $signed(o_Immediate));
        end
    endtask

    // Stimulus Run
    initial begin
        $display("\n=======================================================");
        $display("   Time   | Instruction | Type   | Imm (Hex)  | Imm (Dec)");
        $display("=======================================================");

        // Pass any 32-bit hex value—the testbench auto-detects the type:
        apply_test(32'hFFF10093); // Automatic I-Type
        apply_test(32'h00112223); // Automatic S-Type
        apply_test(32'hFE208CE3); // Automatic B-Type
        apply_test(32'h001000EF); // Automatic J-Type

        $display("=======================================================\n");
        $finish;
    end

endmodule
