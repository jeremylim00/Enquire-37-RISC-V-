module testbench();

    reg signed [31:0] i_Reg_A = 0;
    reg signed [31:0] i_Reg_B = 0;
    reg [2:0]         i_Branch_Sel = 0;
    wire              o_Branch_Taken;

    // Instantiate Unit Under Test (UUT)
    top ai45 (
        .i_Reg_A(i_Reg_A), 
        .i_Reg_B(i_Reg_B), 
        .i_Branch_Sel(i_Branch_Sel), 
        .o_Branch_Taken(o_Branch_Taken)
    );

    // Waveform Dump Config
    initial begin 
        $dumpfile("testbench.vcd");
        $dumpvars(0, testbench);
    end 

    // Helper task to drive stimulus and display output cleanly
    task run_test;
        input signed [31:0] a;
        input signed [31:0] b;
        input [2:0]         sel;
        input [31:0]        op_name; // ASCII string for display
        begin
            i_Reg_A      = a;
            i_Reg_B      = b;
            i_Branch_Sel = sel;
            #10;
            $display("%8t | %s  | %11d | %11d |    %b    | %s", 
                     $time, op_name, i_Reg_A, i_Reg_B, o_Branch_Taken,
                     o_Branch_Taken ? "TAKEN" : "NOT TAKEN");
        end
    endtask

    // Stimulus Execution
    initial begin
        $display("\n==================================================================");
        $display("   Time   | Op   |   Reg A     |   Reg B     | Taken? | Status");
        $display("==================================================================");

        // --- 1. Test BEQ (3'b000: Equal) ---
        run_test(10, 10, 3'b000, "BEQ"); // Should pass (Taken)
        run_test(10, 20, 3'b000, "BEQ"); // Should fail (Not Taken)

        // --- 2. Test BNE (3'b001: Not Equal) ---
        run_test(10, 20, 3'b001, "BNE"); // Should pass (Taken)
        run_test(10, 10, 3'b001, "BNE"); // Should fail (Not Taken)

        // --- 3. Test BLT (3'b100: Less Than, Signed) ---
        run_test(-5, 10, 3'b100, "BLT"); // Should pass (-5 < 10)
        run_test(10, -5, 3'b100, "BLT"); // Should fail (10 < -5 is False)
        run_test(10, 10, 3'b100, "BLT"); // Should fail (10 < 10 is False)

        // --- 4. Test BGE (3'b101: Greater/Equal, Signed) ---
        run_test(10, -5, 3'b101, "BGE"); // Should pass (10 >= -5)
        run_test(10, 10, 3'b101, "BGE"); // Should pass (10 >= 10)
        run_test(-5, 10, 3'b101, "BGE"); // Should fail (-5 >= 10 is False)

        $display("==================================================================\n");
        $finish;
    end

endmodule
